FROM debian:bookworm-slim

ARG VERSION=dev
ARG SOURCE_COMMIT=unknown

LABEL org.opencontainers.image.title="OpenFlux-mod" \
      org.opencontainers.image.description="Private downstream OpenFlux runtime image" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$SOURCE_COMMIT" \
      org.opencontainers.image.source="https://github.com/LevL-max/OpenFlux-mod"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates iproute2 iptables \
    && rm -rf /var/lib/apt/lists/*

COPY dist/openflux-linux-amd64 /usr/local/bin/openflux
RUN chmod 0755 /usr/local/bin/openflux

USER 0:0
ENTRYPOINT ["/usr/local/bin/openflux"]
